    {
      "parameters": {
        "jsCode": "// Hardcoded list of exactly three research topics.\nreturn [\n  { json: { topic: 'Coffee consumption and mortality risk' } },\n  { json: { topic: 'Red meat consumption and cancer risk' } },\n  { json: { topic: 'Screen time and adolescent mental health' } },\n];"
      },
      "id": "446d5b1e-a4f1-4619-835c-61d417148af5",
      "name": "Build Topics List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {},
      "id": "0a8c0291-c176-4f51-aab0-1653f873cc5d",
      "name": "Ingestion Complete",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        896,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.semanticscholar.org/graph/v1/paper/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.topic }}"
            },
            {
              "name": "fields",
              "value": "title,abstract,authors,year,venue,citationCount,paperId,externalIds,publicationTypes"
            },
            {
              "name": "year",
              "value": "={{ $now.minus({ years: 15 }).year }}-"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "3bf4fe4c-c907-486e-b328-f372b921b549",
      "name": "Search Semantic Scholar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        896,
        192
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Current topic comes from the loop node's paired item.\nlet topic = null;\ntry {\n  topic = $('Loop Over Topics').item.json.topic;\n} catch (e) {\n  topic = null;\n}\n\nconst resp = $input.first() ? $input.first().json : {};\nconst papers = Array.isArray(resp.data) ? resp.data : [];\n\nconst out = [];\nfor (const p of papers) {\n  // Ignore papers without abstracts\n  if (!p.abstract) continue;\n\n  const authors = Array.isArray(p.authors)\n    ? p.authors.map((a) => a && a.name).filter(Boolean).join(', ')\n    : '';\n\n  out.push({\n    json: {\n      topic,\n      title: p.title || null,\n      abstract: p.abstract,\n      authors: authors || null,\n      year: typeof p.year === 'number' ? p.year : (p.year ? Number(p.year) : null),\n      venue: p.venue || null,\n      citation_count: typeof p.citationCount === 'number' ? p.citationCount : null,\n      paper_id: p.paperId || null,\n      external_ids: p.externalIds ? JSON.stringify(p.externalIds) : null,\n      publication_types: Array.isArray(p.publicationTypes) ? JSON.stringify(p.publicationTypes) : null,\n    },\n  });\n}\n\nreturn out;"
      },
      "id": "d9c60673-d83d-4893-b6bf-f479ad3e0e7a",
      "name": "Filter & Map Papers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        144
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT paper_id FROM papers WHERE paper_id = ANY(string_to_array($1, ','));",
        "options": {
          "queryReplacement": "={{ $input.all().map(i => i.json.paper_id).filter(Boolean).join(\",\") }}"
        }
      },
      "id": "413b84f9-582a-46f5-807c-a84ba54c0c15",
      "name": "Check Existing Paper IDs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "credentials": {
        "postgres": {
          "name": "Paper Trail PostgreSQL"
        }
      },
      "position": [
        1344,
        144
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Drop papers whose paper_id already exists in the papers table so we\n// don't reprocess papers we already have. Return the surviving papers plus\n// one summary item for the master pipeline.\nconst existingRows = $('Check Existing Paper IDs').all().map((i) => i.json);\nconst existing = new Set(\n  existingRows\n    .filter((r) => r && Object.keys(r).length > 0 && r.paper_id != null)\n    .map((r) => String(r.paper_id)),\n);\n\nconst fetchedRows = $('Filter & Map Papers').all().map((i) => i.json || {});\nconst papers_fetched = fetchedRows.length;\nconst out = [];\nlet papers_skipped = 0;\n\nfor (const p of fetchedRows) {\n  if (p.paper_id != null && existing.has(String(p.paper_id))) {\n    papers_skipped += 1;\n    continue;\n  }\n  out.push({ json: p });\n}\n\nconst papers_returned = out.length;\nout.push({\n  json: {\n    __summary: true,\n    papers_fetched,\n    papers_skipped,\n    papers_returned,\n  },\n});\n\nreturn out;"
      },
      "id": "59d0dd53-01ab-4a58-921b-0e7af3ba2141",
      "name": "Filter Out Existing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        144
      ]
    },
