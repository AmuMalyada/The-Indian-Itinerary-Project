        "jsCode": "const s = $getWorkflowStaticData('global');\nconst first = $input.first() ? ($input.first().json || {}) : {};\nconst hasCounts = first.papers_inserted !== undefined && first.papers_skipped !== undefined;\nconst storage_success = !first.error && hasCounts;\n\nif (storage_success) {\n  s.papers_inserted = Number(first.papers_inserted) || 0;\n  s.papers_skipped = Number(first.papers_skipped) || 0;\n  s.storage_error = null;\n} else {\n  s.storage_error = first.error ? (first.error.message || String(first.error)) : 'Storage failed or returned unexpected output';\n}\n\nreturn [{\n  json: {\n    ...first,\n    storage_success,\n    storage_error: s.storage_error,\n  },\n}];"
